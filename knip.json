{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.test.mjs",
        "tools/*.{mjs,ts}",
        "tools/harness/entry.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,mjs}",
        "tools/**/*.{mjs,ts}",
        "!src/packages/**"
      ]
    },
    "src/packages/delta": {
      "entry": [
        "build.mjs"
      ],
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "src/packages/audio": {
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "src/packages/gl": {
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "src/packages/geometry": {
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "src/packages/web": {
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "src/packages/config": {
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "src/packages/glsl": {
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "src/packages/math": {
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "src/packages/journey": {
      "entry": [
        "*.test.mjs"
      ],
      "project": [
        "*.{ts,mjs}"
      ]
    },
    "src/packages/quality": {
      "entry": [
        "*.test.mjs"
      ],
      "project": [
        "*.{ts,mjs}"
      ]
    }
  }
}