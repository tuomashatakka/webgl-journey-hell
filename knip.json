{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.test.mjs",
        "tools/*.{mjs,ts}",
        "tools/harness/entry.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,mjs}",
        "tools/**/*.{mjs,ts}",
        "!src/packages/**"
      ]
    },
    "src/packages/*": {
      "entry": [
        "*.test.mjs",
        "build.mjs"
      ],
      "project": [
        "*.{ts,mjs}"
      ]
    }
  }
}